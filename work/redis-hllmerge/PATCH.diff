+/* Merge a dense HLL's packed registers into 'max', eight registers at a time,
+ * and keep the larger of each pair.
+ *
+ * Registers are packed six bits apiece in a little-endian bit stream, so the
+ * group holding registers 8k..8k+7 begins on a byte boundary and spans exactly
+ * six bytes. This routine reads those six bytes, spreads the eight six-bit
+ * fields one per byte, and takes the byte-wise maximum against max[8k..8k+7]
+ * in a single SWAR step.
+ *
+ * Bounds. The wide loop runs 2047 times, for registers 0..16375. Its eight-byte
+ * load starts at byte 6k with k <= 2046, so the highest byte it touches is
+ * 12283, against an array whose last byte is 12287. The tail covers registers
+ * 16376..16383 as two groups of four, each read as exactly the three bytes it
+ * occupies; the last of those ends at byte 12287. Nothing is read outside the
+ * array, and no register is left out.
+ *
+ * Contrast the upstream loop, which uses HLL_DENSE_GET_REGISTER and so reads
+ * _p[_byte+1] unconditionally. For register 16383, whose six bits end inside
+ * byte 12287, that is a read of byte 12288 -- one past the array, and
+ * unnecessary, since the register lies wholly inside the byte. The two
+ * _Static_asserts above are what let this routine assume the sizes it assumes.
+ */
+static void hllMergeDense(uint8_t *max, const uint8_t *registers) {
+    const uint64_t H = 0x8080808080808080ULL;
+    const uint8_t *p = registers;
+    int i;
+
+    for (i = 0; i < HLL_REGISTERS - 8; i += 8, p += 6) {
+        uint64_t w, v, m, sel, out;
+
+        /* The registers are a byte stream whose bit order is fixed by
+         * HLL_DENSE_GET_REGISTER, not by the host, so the load is little-
+         * endian: on a big-endian build the wide value has to be swapped.
+         * Assembling the bytes by hand instead costs eight loads where this
+         * costs one -- clang -O3 turns the loop into movzbl/shift chains, not
+         * into a single load -- so the swap is the cheaper way to be correct. */
+        memcpy(&w, p, sizeof(w));
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+        w = __builtin_bswap64(w);
+#endif
+
+        v  =  (w        & 0x3f)
+           | ((w >>  6) & 0x3f) <<  8
+           | ((w >> 12) & 0x3f) << 16
+           | ((w >> 18) & 0x3f) << 24
+           | ((w >> 24) & 0x3f) << 32
+           | ((w >> 30) & 0x3f) << 40
+           | ((w >> 36) & 0x3f) << 48
+           | ((w >> 42) & 0x3f) << 56;
+
+        memcpy(&m, max + i, sizeof(m));
+        /* max[] is not guaranteed to hold registers: hllMerge() is
+         * MAX(max[i], register), and a caller may hand it anything, so a byte
+         * of m can have bit 7 set. Comparing m directly would be wrong twice
+         * over -- the borrow trick needs bit 7 free -- so compare the low
+         * seven bits and let any byte with bit 7 set win outright, which it
+         * must, since v is a six-bit register and so is at most 63.
+         *
+         * With bit 7 of (m & ~H) clear, ((m & ~H) | H) lies in [128, 255] and
+         * v in [0, 63], so the subtraction stays inside the byte and sets H
+         * exactly in the bytes where (m & ~H) >= v. The multiply then
+         * broadcasts that selector across each byte: the shifted selector has
+         * only bit 0 of each byte set, and n*0xff never carries out of a byte
+         * for n in {0,1}. */
+        sel = ((((((m & ~H) | H) - v) & H) | (m & H)) >> 7) * 0xffULL;
+        out = (m & sel) | (v & ~sel);
+        memcpy(max + i, &out, sizeof(out));
+    }
+
+    for (; i < HLL_REGISTERS; i += 4, p += 3) {
+        uint32_t w = (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+                     ((uint32_t)p[2] << 16);
+        int k;
+
+        for (k = 0; k < 4; k++) {
+            uint8_t val = (w >> (6 * k)) & 0x3f;
+            if (val > max[i + k]) max[i + k] = val;
+        }
+    }
+}
