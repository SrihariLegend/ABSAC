# Rust
/target/
**/target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Repomix
repomix-output.xml

# OS
.DS_Store
Thumbs.db

# Dirac
.dirac-cache/

# Local scratch (native test temp files; /tmp is a small tmpfs here)
/tmp/

# Vendored third-party validation tools (install with:)
#   pip3 install --target vendor/z3py z3-solver
/vendor/

gate4/differential
gate4/differential_asan

# The real history lives here; never add it as a nested repo
/recovery.git/

# External-project investigation workspace (work/).
# Checkouts, build products and raw profiles are large and refetchable by
# scripts, so they are ignored. Everything else under work/ -- patches, notes,
# profile summaries, harness scripts, results -- IS committed, because the whole
# point of this directory is that evidence must outlive /tmp.
# `**` rather than `*` because targets nest (work/pr-targets/jq/src/).
# Build trees are named `build-*` by convention so that one rule catches them;
# a tree called `t/` or `d/` is 56 MB of object files that nothing can identify
# from its name.
work/**/src/
work/**/bin/
work/**/build/
work/**/build-*/
work/**/data/
work/**/bc/
work/**/dl/
work/**/work/
work/**/eval/
work/**/prof/
work/**/ir/
*.callgrind
work/**/*.s
work/**/*.rdb
work/**/*.log
# pngtest writes to its working directory, so running it from the wrong place
# drops a multi-megabyte PNG into the source tree. The audit runs from work/.
pngout.png

# The referee writes these into whatever --workdir it is given. Regenerable in
# one command; the .c and .ll files beside them are the evidence and are kept.
work/**/exe
work/**/time_exe

# Fetched third-party corpora and referee workdirs. Both are regenerable with a
# committed script (scripts/fetch-external.sh; a referee --workdir run), so they
# are not evidence and do not belong in the history. The hashes that pin what
# they were are committed under work/audit/.
work/**/external/
work/**/wd*/

# Compiled witnesses. Named exactly, not by glob: `test_*` would also catch
# test_merge.c, which is the artifact. `*.inc` is derived from PATCH.diff by the
# awk line in test_merge.c's header and is deliberately NOT committed -- a stale
# .inc beside an edited patch would let the witness test code nobody ships.
work/**/test_merge
work/**/*.inc
work/*/*.o
work/*/*.bin
work/*/*.png
work/*/*.json
